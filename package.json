{
  "name": "exploreasl_gui",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:e2e-bundle": "node scripts/check-e2e-bundle.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "vitest run",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:e2e": "pnpm --dir e2e-tests test",
    "test:e2e:unit": "pnpm --dir e2e-tests test:unit",
    "typecheck:e2e": "pnpm --dir e2e-tests typecheck",
    "spec:validate": "openspec validate --specs --strict --no-interactive",
    "spec:validate:all": "openspec validate --all --strict --no-interactive",
    "spec:doctor": "openspec doctor --json",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "oxlint --deny-warnings",
    "lint:backend": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format": "pnpm format:frontend && pnpm format:backend",
    "format:frontend": "prettier --write .",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "pnpm format:check:frontend && pnpm format:check:backend",
    "format:check:frontend": "prettier --check .",
    "format:check:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings",
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings -- --check",
    "typecheck": "pnpm bindings:check && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@niivue/niivue": "^0.69.0",
    "@nivo/scatterplot": "^0.99.0",
    "@nivo/swarmplot": "^0.99.0",
    "@tabler/icons-react": "^3.50.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "mantine-datatable": "^9.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "^8.5.1",
    "react-virtuoso": "^4.18.20",
    "unicode-case-folding": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
